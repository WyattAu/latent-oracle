{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (GCC, native)",
      "description": "Developer build with native ISA (BMI2/AVX-512 selected at runtime regardless)",
      "binaryDir": "${sourceDir}/build/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-march=native -Wall -Wextra -Wpedantic",
        "LO_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (GCC, native)",
      "description": "Optimized build for benchmarking and play",
      "binaryDir": "${sourceDir}/build/release",
      "generator": "Ninja",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native -O3 -DNDEBUG -Wall -Wextra -Wpedantic"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Debug (Clang, native)",
      "description": "Alternate-compiler leg exercising non-GCC-gated paths",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "generator": "Ninja",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan",
      "description": "Sanitizer build for the perft suite",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "generator": "Ninja",
      "inherits": "debug",
      "cacheVariables": {
        "LO_ENABLE_ASAN": "ON",
        "LO_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "description": "Thread-sanitized build for the UCI IO-thread path",
      "binaryDir": "${sourceDir}/build/tsan",
      "generator": "Ninja",
      "inherits": "debug",
      "cacheVariables": {
        "LO_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
